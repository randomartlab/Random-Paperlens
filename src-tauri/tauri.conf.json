{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rd学术阅读器",
  "version": "0.4.7",
  "identifier": "com.litdesk.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rd学术阅读器",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExQzFENjcwMjlCOEQxQjUKUldTMTBiZ3BjTmJCb2NYaituNk85UnE4TUZUYWRGZVg4WHhOR0U0TjdMVWFZN2YyRDlrR1pESWUK",
      "endpoints": [
        "https://github.com/randomartlab/Random-Paperlens/releases/latest/download/latest.json"
      ]
    }
  }
}
